# Copy this file to ".env" and change the values if needed.
# The real .env file is NOT uploaded to GitHub (see .gitignore).

# Frontend addresses allowed to call this backend (comma-separated).
# On AWS, add your instance address, e.g. http://<public-ip>:5173
FRONTEND_URLS=http://localhost:5173

# Ollama (the app that runs the AI model)
OLLAMA_URL=http://localhost:11434
# Model to use – must be downloaded first with: ollama pull <model>
OLLAMA_MODEL=llama3.2
# Seconds to wait for an answer
OLLAMA_TIMEOUT_SECONDS=120
